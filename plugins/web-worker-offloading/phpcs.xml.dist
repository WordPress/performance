<?xml version="1.0"?>
<ruleset name="WPP-Web-Worker-Offloading" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">
	<description>WordPress Coding Standards for Web Worker Offloading</description>

	<rule ref="../../tools/phpcs/phpcs.ruleset.xml"/>

	<config name="text_domain" value="web-worker-offloading"/>

	<file>.</file>
</ruleset>
