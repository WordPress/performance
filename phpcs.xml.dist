<?xml version="1.0"?>
<ruleset name="WPP" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">
	<description>WordPress Coding Standards for the Performance Features.</description>
	<rule ref="tools/phpcs/phpcs.ruleset.xml"/>

	<config name="text_domain" value="performance-lab,default"/>

	<file>.</file>

	<!--Ignore plugins directory-->
	<exclude-pattern>./plugins/*</exclude-pattern>
</ruleset>
