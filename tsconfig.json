{
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "allowJs": true,
    "target": "es2020",
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "*.js",
    "*.mjs",
    "*.ts",
  ],
  "exclude": [
    "plugins/*/build/*"
  ]
}
